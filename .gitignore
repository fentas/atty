# ---- Zig --------------------------------------------------------------------
zig-out/
.zig-cache/

# ---- atty build outputs -----------------------------------------------------
dist/
*.tar.gz
*.sha256

# ---- Jekyll / docs ----------------------------------------------------------
_site/
docs/.jekyll-cache/
docs/.jekyll-metadata
docs/.bundle/
docs/vendor/

# ---- Editors / OS -----------------------------------------------------------
.DS_Store
.idea/
.vscode/
.claude/
*.swp
*.swo
*~

# ---- direnv / asdf-style ----------------------------------------------------
.envrc.local
.tool-versions.local

# ---- Test / coverage tmp ----------------------------------------------------
*.log
coverage/
# e2e harness writes `actual/` next to `golden/` when a snapshot diff
# fails, as diagnostic output. Not tracked.
/tests/e2e/*/actual/

# ---- User config -------------------------------------------------------------
# src/config.zig is per-user; src/config.def.zig is the committed template.
# build.zig bootstraps config.zig from the template on first build, so a
# fresh clone "just works" and personal overrides never conflict on pull.
/src/config.zig
