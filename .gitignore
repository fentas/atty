# ---- Zig --------------------------------------------------------------------
zig-out/
.zig-cache/

# ---- atty build outputs -----------------------------------------------------
dist/
*.tar.gz
*.sha256

# ---- Jekyll / docs ----------------------------------------------------------
_site/
docs/.jekyll-cache/
docs/.jekyll-metadata
docs/.bundle/
docs/vendor/

# ---- Editors / OS -----------------------------------------------------------
.DS_Store
.idea/
.vscode/
.claude/
*.swp
*.swo
*~

# ---- direnv / asdf-style ----------------------------------------------------
.envrc.local
.tool-versions.local

# ---- Test / coverage tmp ----------------------------------------------------
*.log
coverage/
# e2e harness writes `actual/` next to `golden/` when a snapshot diff
# fails, as diagnostic output. Not tracked.
/tests/e2e/*/actual/

# cast.json is an asciinema-style replay artifact regenerated on
# every --update. PTY chunking is non-deterministic, so the byte
# layout shifts run-to-run even when the test passes. Never compared
# during snapshot diff (only grid.txt + grid.sgr are), so tracking it
# just creates diff noise.
/tests/e2e/*/golden/cast.json

# ---- User config -------------------------------------------------------------
# src/config.zig is per-user; src/config.def.zig is the committed template.
# build.zig bootstraps config.zig from the template on first build, so a
# fresh clone "just works" and personal overrides never conflict on pull.
/src/config.zig

# ignore review folders but keep for reference
/gpt-review
# Sandbox build context (binaries staged for docker build).
/tests/sandbox/.build/
