[Unit]
Description=atty security guard sidecar
Documentation=https://github.com/fentas/atty/blob/master/atty-guard/README.md
After=network.target

[Service]
# atty-guard runs as a SYSTEM daemon under a dedicated `atty` user,
# not as systemd-user. The atty:atty user/group is created by
# `contrib/install.sh` (which requires sudo). atty proxies running as
# regular users connect to the daemon's UDS at
# /run/atty-guard/atty-guard.sock — group-readable by the `atty`
# group, so users in that group can talk to the daemon.
#
# WHY this shape (not systemd-user): atom files + URL trust decisions
# influence detection. User-writable trust state is a DOS vector — a
# malicious process running as $USER could poison atoms with common
# commands and force the user to disable atty-guard. Putting the
# daemon under a dedicated user keeps detection state outside the
# user's write reach; mutations go through `sudo atty-guard atoms
# add/remove` etc. so admin intent is required.
User=atty
Group=atty

ExecStart=/usr/local/bin/atty-guard
Restart=on-failure
RestartSec=2
StartLimitIntervalSec=10
StartLimitBurst=5

# /run/atty-guard/ created by systemd, owned atty:atty, group-
# readable so atty proxies (added to the `atty` group) can read the
# socket. Daemon binds atty-guard.sock under here at startup.
RuntimeDirectory=atty-guard
RuntimeDirectoryMode=0750
# /var/lib/atty-guard/ for atom files + user URL decisions. Owned
# atty:atty, NOT user-writable; mutations go through the daemon's
# sudo-mediated CLI.
StateDirectory=atty-guard
StateDirectoryMode=0750

# Lockdown — same shape as the prior systemd-user unit, adjusted
# for the system-daemon context.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallFilter=~@mount @reboot @swap @raw-io @cpu-emulation @debug @module
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
