# atty statusbar — the always-present bottom status bar (DECSTBM-reserved).
cols 80
rows 12
timeout_ms 15000

spawn $ATTY bash --norc --noprofile -i
wait_for "$"
sleep 900
type "echo atty wraps your shell, transparently" irregular
sleep 300
key Enter
wait_for "transparently"
sleep 1400
type "uname -sm" irregular
sleep 300
key Enter
wait_stable 250
sleep 1700
type "exit\r"
exit_code 0
