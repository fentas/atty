# Per-Dockerfile ignore (BuildKit picks up <Dockerfile>.dockerignore
# next to the Dockerfile). Scoped to the sandbox build so the
# top-level Dockerfile keeps its full repo context.
#
# The sandbox image only needs:
#   - atty-guard/ (Rust sidecar source)
#   - src/modules/security_guard/data/ (shared atom corpus)
#   - tests/sandbox/.build/atty (staged host build)
.git/
.zig-cache/
zig-out/
atty-guard/target/
dist/
chat/
gpt-review/
tests/e2e/*/golden/
tests/e2e/*/last/
tests/integration/tmp/
tests/sandbox/.build/atty-guard
