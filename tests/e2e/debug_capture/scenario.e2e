# debug_capture — Alt+Shift+D dumps the in-memory recorder to a report file and
# prints a one-line toast with the path. This scenario validates the Action →
# save → toast WIRING end-to-end (no snapshot: the report path carries a
# timestamp). Report *content* (valid JSON + the three streams + escaping) is
# covered by the unit tests in src/debug_report_tests.zig.

cols 80
rows 8
timeout_ms 6000

spawn $ATTY bash --norc --noprofile -i
wait_for "$"
sleep 200
type "echo hello-debug\r"
wait_for "hello-debug"
sleep 200
# Alt+Shift+D (legacy ESC + D) → debug_capture.
type "\x1bD"
wait_for "report saved"
sleep 100
type "exit\r"
exit_code 0
