# ghost_atty_init_bash — verify ghost + history under the exact
# shape `atty init bash` sets up in a real user's .bashrc.
#
# Layout: `;A` + `;B` from PS1, `;D` from PROMPT_COMMAND, no `;C`.

cols 60
rows 8
timeout_ms 5000

spawn $ATTY bash --norc --noprofile -i
wait_for "$"

# Reset the scenario-private history file so re-runs on the same
# host don't accumulate prior commits — the cat snapshot below
# asserts on exact file contents.
type "rm -f /tmp/atty-e2e-ghost-atty-init-bash\r"
wait_for "$"

# Mirror what `atty init bash` injects into the live shell:
#   __atty_osc133_d() { ... '\033]133;D;%s\007' ... }
#   PROMPT_COMMAND="__atty_osc133_d;..."
#   PS1=...;A...$PS1...;B...
type "__atty_osc133_d() { local __code=$?; printf '\\033]133;D;%s\\007' \"$__code\"; }\r"
wait_for "$"
type "PROMPT_COMMAND='__atty_osc133_d'\r"
wait_for "$"
type "PS1=$'\\[\\033]133;A\\007\\]$ \\[\\033]133;B\\007\\]' && clear\r"
wait_for "$"
sleep 200

# Record a unique entry — history.onLineCommit fires under the
# integration, appends to /tmp/atty-e2e-ghost-atty-init-bash and the
# in-memory ring.
type "echo init-bash-record-99999\r"
wait_for "init-bash-record-99999"
sleep 300

# Type a prefix; ghost overlay should paint.
type "echo init-bash-r"
wait_stable 250
snapshot ghost_visible

# Clear the ghost + line; verify the file is on disk too.
# `clear` first so the cat snapshot starts from a clean grid —
# without it, scrollback alignment is sensitive to slave row count
# (slim vs full) and timing.
key Enter
sleep 200
type "clear && cat /tmp/atty-e2e-ghost-atty-init-bash\r"
wait_stable 250
snapshot history_written

type "exit\r"
exit_code 0
