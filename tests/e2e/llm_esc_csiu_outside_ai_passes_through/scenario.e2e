# llm_esc_csiu_outside_ai_passes_through — pins the CSI-u Esc
# cleanup gate.
#
# When the user fires Esc OUTSIDE AI mode on a kitty-kbd terminal,
# the binding matches but llm_exec_cancel's onAction returns false
# (no work). The proxy must then translate `\x1b[27u` → legacy
# `\x1b` so the shell sees bare Esc, not raw CSI-u bytes that
# would echo as mojibake.
#
# Regression for proxy.zig's matched_binding gating fix on PR #34
# round 2: without that fix, the binding match would suppress the
# CSI-u cleanup path and the raw bytes would flow through.

cols 80
rows 6
timeout_ms 5000

spawn $ATTY bash --norc --noprofile -i
wait_for "$"
sleep 200

# Fire CSI-u Esc as an isolated input event so the proxy's
# keymap.match sees exactly `\x1b[27u` (exact byte equality is
# required to trigger the binding). With the proxy's
# matched_binding gating fix:
#   - keymap match → llm_exec_cancel → onAction returns false
#     (no AI mode, no pending injection)
#   - matched_binding cleared, CSI-u cleanup translates the bytes
#     back to legacy `\x1b`
#   - bash sees bare Esc (no-op at the prompt)
# Without the fix, raw `\x1b[27u` would flow through and bash
# would echo `[27u` mojibake on the prompt line.
type "\x1b[27u"
sleep 300

# Send Enter as a separate poll() event. Bash submits an empty
# command, prompt advances — confirms no mojibake was queued on
# the readline buffer.
type "\r"
sleep 300
snapshot esc_csiu_outside_ai

# Clean exit.
type "exit\r"
exit_code 0
