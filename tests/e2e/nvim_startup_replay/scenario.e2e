# nvim_startup_replay — pipe the captured nvim master-output bytes
# through atty and snapshot the resulting grid. Any byte-stream
# corruption introduced by atty (cursor_tracker CSI parsing, future
# DSR filtering, sync output wraps, etc.) would show up as the
# rendered grid drifting from the golden.
#
# We `cat` the fixture using `$ATTY_SCENARIO_DIR`, which the harness
# sets to the absolute path of this scenario's directory. The repo
# root isn't directly exposed; everything's resolved relative to the
# scenario dir to keep fixtures co-located with their consumers.

cols 80
rows 24
timeout_ms 5000

spawn $ATTY bash --norc --noprofile -i
wait_for "$"

# Replay the captured nvim startup. cat dumps the raw bytes
# verbatim — bash performs no interpretation. atty's master read
# may split the chunk anywhere; the e2e vt-grid renders the final
# state.
type "cat \"$ATTY_SCENARIO_DIR/../fixtures/nvim-startup-4k.bin\"\r"
sleep 600
snapshot nvim_initial_frame

# Cleanly exit bash so the harness can collect the exit code.
# The fixture left the terminal in alt-screen mode in the
# harness's view (even though vt-grid ignores ?1049h, residual
# state from the captured nvim run might have leaked); the exit
# itself unwinds the shell normally and the harness shutdown
# tears down the rest.
type "exit\r"
exit_code 0
