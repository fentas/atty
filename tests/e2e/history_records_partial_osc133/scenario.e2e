# history_records_partial_osc133 — verifies that history's onLineCommit
# WRITES TO DISK under Ghostty's partial OSC 133 shape (only `;A`).
#
# Pre-PR-#17 behaviour: `inInputPhase()` returned false in `.at_prompt`,
# the recording gate (`osc.active && !inInputPhase()`) evaluated true,
# `dispatchLineCommit` was skipped, and history.write was never called
# → the file stayed empty.
# Post-fix: `.at_prompt` counts as input phase, recording fires, the
# file gains the recorded line.
#
# We verify by `cat`ing the history file inside the scenario and
# snapshotting — if the line is in the cat output, the file was
# written; if not, the gate is broken.

cols 60
rows 8
timeout_ms 5000

spawn $ATTY bash --norc --noprofile -i
wait_for "$"

# Set PS1 to embed `;A` — Ghostty's partial-OSC133 shape.
type "PS1='\\[\\033]133;A\\007\\]$ ' && clear\r"
wait_for "$"
sleep 200

# Record a unique line through atty. history.onLineCommit should fire
# and append to /tmp/atty-e2e-history-records-partial-osc133.
type "echo unique-record-12345\r"
wait_for "unique-record-12345"
sleep 300

# Cat the history file. With the fix, the file contains the line;
# without the fix, the cat output is empty (or the file is missing
# and cat reports an error — either way no recorded line).
type "cat /tmp/atty-e2e-history-records-partial-osc133\r"
sleep 400
snapshot history_written

# Clean exit.
type "exit\r"
exit_code 0
