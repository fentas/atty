# delete_history_match_after_uparrow — verify Ctrl+Shift+D works
# after recalling a line via Up arrow.
#
# Flow:
#   1. Set up OSC 133 markers (`;A`+`;B` in PS1) so the tracker
#      can capture the recalled line.
#   2. Record a unique entry; bash's history -s puts it in
#      readline's recall list too.
#   3. Reset the history-module file so the e2e is deterministic
#      across re-runs.
#   4. Type the entry through atty so history.onLineCommit records
#      it on disk + in-memory.
#   5. Press Up arrow — bash recalls "echo UPARROW-TARGET-99999"
#      onto the prompt. line_state.uncertain becomes true (CSI).
#   6. Fire Ctrl+Shift+D via the kitty kbd CSI-u byte sequence.
#      With the fix, the handler falls back to the OSC 133 capture
#      stream and dispatches the deletion. Without the fix,
#      line_state.uncertain would short-circuit the handler and
#      the deletion never fires.
#   7. Verify the file no longer contains the entry via a
#      grep / HIT-COUNT assertion (a literal `cat` would race
#      atty's history-write timing across test runs — see the
#      block above the verification command for the full story).

cols 60
rows 10
timeout_ms 5000

spawn $ATTY bash --norc --noprofile -i
wait_for "$"

# Reset the history-module file (deterministic re-runs).
type "rm -f /tmp/atty-e2e-delete-uparrow\r"
wait_for "$"

# Mirror what `atty init bash` injects (PS1 with `;A`+`;B`).
type "PS1=$'\\[\\033]133;A\\007\\]$ \\[\\033]133;B\\007\\]' && clear\r"
wait_for "$"
sleep 200

# Record the entry — atty's history module appends to the file
# via onLineCommit. Bash's own history also gets the entry so Up
# arrow can recall it.
type "echo UPARROW-TARGET-99999\r"
wait_for "UPARROW-TARGET-99999"
sleep 300

# Press Up arrow — bash recalls "echo UPARROW-TARGET-99999" onto
# the prompt. The OSC 133 tracker captures it via the `;B`-onward
# stream. line_state.uncertain becomes true (CSI), so the handler
# must fall back to the capture stream.
key Up
sleep 300

# Ctrl+Shift+D — kitty kbd CSI-u for 'd' with Ctrl+Shift (modifier
# 6). atty's binding fires; with the fix, the handler reads the
# recalled line from osc133_tracker.currentInput() and dispatches
# delete_history_match. The proxy also sends Ctrl+U to clear the
# shell prompt.
type "\x1b[100;6u"
sleep 400

# Verify the file no longer contains the entry. Pre-fix it would
# still be there because the handler skipped on uncertain.
#
# Why grep through a shell variable instead of `cat`-ing the whole
# file:
#   • The file accumulates atty's other recorded commands (rm, PS1,
#     …) across test runs — the recorded `rm` is appended BEFORE
#     bash actually runs it, so the file persists with stale
#     entries even though the scenario starts with an `rm -f`. The
#     exact order also races with how fast bash flushes vs atty's
#     history-write timing. A full snapshot is unavoidably brittle.
#   • The grep command line itself gets recorded into the same
#     file. Naively `grep -c UPARROW-TARGET-99999` would match its
#     OWN recorded line and never report 0 — false negative on the
#     deletion. Using `grep "echo $TGT"` makes the recorded grep
#     line contain literal `$TGT`, not the expanded sentinel, so
#     the pattern only matches the ORIGINAL recorded entry.
# `HIT-COUNT=0` means the delete fired; `HIT-COUNT=1` means it
# didn't.
type "TGT='UPARROW-TARGET-99999'; echo HIT-COUNT=$(grep -c \"echo $TGT\" /tmp/atty-e2e-delete-uparrow); echo CHECK-DONE\r"
# Wait for the unique sentinel rather than sleeping a fixed
# duration — on slow CI hosts the grep/echo may not have flushed
# in 400 ms, so the snapshot would capture an in-progress prompt
# and reintroduce the flake we're trying to remove.
wait_for "CHECK-DONE"
snapshot history_after_delete

# Clean exit.
type "exit\r"
exit_code 0
